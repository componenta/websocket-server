{
    "name": "componenta/websocket-server",
    "description": "WebSocket server, protocol, socket, and connection primitives for Componenta",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^3.0.0",
        "componenta/http": "^1.0",
        "psr/container": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\WebSocket\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\WebSocket\\Tests\\": "tests/"
        }
    },
    "extra": {
        "componenta": {
            "config-providers": [
                "Componenta\\WebSocket\\ConfigProvider"
            ]
        },
        "branch-alias": {
            "dev-main": "1.1.x-dev"
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.3",
        "phpbench/phpbench": "^1.7"
    },
    "scripts": {
        "bench": "phpbench run --report=aggregate"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable"
}
